// Prisma Schema for NexaHR Single-Company Internal HRM System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ====================================================
// ENUMS
// ====================================================

enum Role {
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  GENERATED
  PAID
}

enum ApplicationSource {
  MANUAL
  GMAIL
  CAREER_PORTAL
  LINKEDIN
  OTHER
}

enum AiScreeningStatus {
  PENDING
  CONFIRMED
  SCREENED_OUT
  UNMATCHED
  ERROR
}

// ====================================================
// CORE SINGLE-COMPANY USER & AUTH MODELS
// ====================================================

model User {
  id           String   @id @default(uuid())
  employeeCode String   @unique
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         EmployeeProfile?
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]   @relation("UserLeaveRequests")
  approvedLeaves  LeaveRequest[]   @relation("ApprovedLeaves")
  salaryStructure SalaryStructure?
  payslips        Payslip[]
  passwordResetTokens PasswordResetToken[]
  passwordResetOtps   PasswordResetOtp[]
  notifications   Notification[]
  tickets         Ticket[]
  ticketReplies   TicketReply[]
  accountTransactions AccountTransaction[]
  vaultUploads        VaultDocument[]       @relation("VaultUploader")
  vaultIssuedDocs     VaultDocument[]       @relation("VaultIssuedTo")
  announcementAcks    AnnouncementAcknowledgment[]

  @@map("users")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // e.g., "employee:create", "payroll:read"
  description String?
  module      String   // e.g., "PIM", "Payroll", "Attendance"
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

// ====================================================
// EMPLOYEE INFORMATION MANAGEMENT (PIM)
// ====================================================

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations Designation[]
  profiles     EmployeeProfile[]

  @@map("departments")
}

model Designation {
  id           String   @id @default(uuid())
  departmentId String?
  title        String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profiles   EmployeeProfile[]

  @@map("designations")
}

model EmployeeProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  avatarUrl        String?
  gender           String?
  dateOfBirth      DateTime?
  joiningDate      DateTime  @default(now())
  employmentType   String?   @default("FULL_TIME")
  shift            String?   @default("General Morning (09:00 - 17:30)")
  address          String?
  workLocation     String?   @default("Islamabad HQ & Innovation Lab")
  emergencyContact String?
  departmentId     String?
  designationId    String?
  bankName         String?   @default("Standard Chartered Bank")
  accountTitle     String?
  accountNumber    String?
  branchCode       String?
  payoutMethod     String?   @default("Direct Bank Transfer")
  taxStatus        String?   @default("Active Filer")
  ntnNumber        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  @@map("employee_profiles")
}

// ====================================================
// TIME, BIOMETRIC ATTENDANCE & LEAVE MANAGEMENT
// ====================================================

model Attendance {
  id           String           @id @default(uuid())
  userId       String
  date         DateTime         @db.Date
  checkInTime  DateTime
  checkOutTime DateTime?
  status       AttendanceStatus @default(PRESENT)
  totalHours   Float?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("attendances")
}

model LeaveType {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  daysAllowed Int      @default(12)
  isPaid      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id              String      @id @default(uuid())
  userId          String
  leaveTypeId     String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User      @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  approvedBy User?     @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("leave_requests")
}

// ====================================================
// PAYROLL PROCESSING
// ====================================================

model SalaryStructure {
  id                 String   @id @default(uuid())
  userId             String   @unique
  basicSalary        Float
  housingAllowance   Float    @default(0)
  transportAllowance Float    @default(0)
  otherAllowances    Float    @default(0)
  taxDeductions      Float    @default(0)
  otherDeductions    Float    @default(0)
  effectiveDate      DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Payslip {
  id                   String        @id @default(uuid())
  userId               String
  month                Int
  year                 Int
  basicSalary          Float
  totalAllowances      Float
  taxDeductions        Float
  unpaidLeaveDays      Int           @default(0)
  unpaidLeaveDeduction Float         @default(0)
  otherDeductions      Float         @default(0)
  grossSalary          Float
  netSalary            Float
  status               PayslipStatus @default(GENERATED)
  generatedAt          DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([year, month])
  @@map("payslips")
}

// ====================================================
// SECURITY & EPHEMERAL PASSWORD RESET TOKEN MODEL
// ====================================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // SHA-256 digest of 20-byte hex token
  expiresAt DateTime  // Strict 1-hour expiration
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_tokens")
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  email     String
  phone     String?
  otpHash   String
  channel   String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("password_reset_otps")
}

// ====================================================
// NOTIFICATION & ANNOUNCEMENT MODELS
// ====================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      String   @default("info") // "success" | "warning" | "info" | "error"
  category  String   @default("GENERAL") // "ANNOUNCEMENT" | "LEAVE" | "PAYROLL" | "ATTENDANCE" | "GENERAL"
  link      String?  // Navigation path e.g. "/employee/announcements", "/employee/leaves", "/employee/payslips"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("EVENTS") // EVENTS | BENEFITS | MEETINGS | OPERATIONS | CORPORATE
  priority    String   @default("HIGH")   // HIGH | MEDIUM | INFO
  department  String?  @default("Company-Wide (All Offices)")
  summary     String?
  content     String
  author      String   @default("People Operations & HR")
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acknowledgments AnnouncementAcknowledgment[]

  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementAcknowledgment {
  id              String       @id @default(uuid())
  announcementId  String
  userId          String
  acknowledgedAt  DateTime     @default(now())

  announcement    Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_acknowledgments")
}

// ====================================================
// HELPDESK & SUPPORT TICKET MODELS
// ====================================================

model Ticket {
  id           String        @id @default(uuid())
  ticketNumber String        @unique // e.g. "TICK-8021"
  userId       String
  subject      String
  category     String        @default("GENERAL_HR") // IT_HARDWARE | PAYROLL | BENEFITS | WORKPLACE | GENERAL_HR
  priority     String        @default("MEDIUM") // LOW | MEDIUM | HIGH
  status       String        @default("IN_PROGRESS") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  assignedTo   String?       @default("NexaHR Support Team")
  description  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies      TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_replies")
}

// ====================================================
// ACCOUNTS, LEDGER & FINANCIAL TRANSACTIONS
// ====================================================

model AccountTransaction {
  id            String   @id @default(uuid())
  voucherNumber String   @unique // e.g. "TXN-9402"
  title         String
  category      String   // INFRASTRUCTURE, PAYROLL, REVENUE, BENEFITS, HARDWARE, FACILITIES, MARKETING, OPERATIONS, TRAVEL, LEGAL, OTHER
  type          String   @default("EXPENSE") // "EXPENSE" | "INCOME"
  amount        Float
  department    String   @default("Company-Wide")
  date          DateTime @default(now())
  time          String?
  status        String   @default("VERIFIED") // "VERIFIED" | "PENDING" | "FLAGGED"
  paymentMethod String   @default("Corp Visa") // "Corp Visa", "ACH Transfer", "Wire In", "Direct Deposit", "Petty Cash", "Corporate Check"
  ref           String?  // Reference code e.g. "INV-AWS-2026-08"
  taxDeductible Boolean  @default(true)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([type])
  @@index([date])
  @@index([status])
  @@map("account_transactions")
}

// ====================================================
// RECRUITMENT & TALENT ACQUISITION (ATS)
// ====================================================

model JobOpening {
  id           String           @id @default(uuid())
  jobCode      String           @unique // e.g. "JOB-101"
  title        String
  department   String
  location     String
  type         String           @default("Full Time")
  experience   String           @default("3+ Years")
  salary       String?          @default("$100k - $140k")
  status       String           @default("ACTIVE") // "ACTIVE", "PAUSED", "CLOSED"
  description  String?
  requirements String?
  skills       String[]         @default([])
  urgent       Boolean          @default(false)
  postedDate   DateTime         @default(now())
  closingDate  DateTime?
  createdById  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  applications JobApplication[]
  interviews   JobInterview[]

  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@map("job_openings")
}

model JobApplication {
  id            String            @id @default(uuid())
  applicationId String            @unique // e.g. "APP-9901"
  jobOpeningId  String?
  name          String
  email         String
  phone         String?
  role          String
  department    String
  location      String
  experience    String            @default("3 Years")
  rating        Float             @default(5.0)
  stage         String            @default("APPLIED") // "APPLIED" | "SCREENING" | "INTERVIEW" | "OFFER" | "HIRED" | "REJECTED"
  status        String            @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  resumeSummary String?
  notes         String?
  tags          String[]          @default([])
  source        ApplicationSource @default(MANUAL)
  gmailMessageId String?          @unique
  aiScore       Int?
  aiBreakdown   Json?
  aiSummary     String?
  aiStrengths   Json?
  aiGaps        Json?
  aiStatus      AiScreeningStatus? @default(PENDING)
  aiScreenedAt  DateTime?
  resumeUrl     String?
  appliedDate   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  jobOpening    JobOpening?       @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  interviews    JobInterview[]

  @@index([status, aiStatus])
  @@index([stage])
  @@index([jobOpeningId])
  @@index([email])
  @@index([aiStatus])
  @@index([jobOpeningId, email])
  @@index([createdAt])
  @@map("job_applications")
}

model JobInterview {
  id              String          @id @default(uuid())
  interviewCode   String          @unique // e.g. "IV-4011"
  applicationId   String
  jobOpeningId    String?
  candidateName   String
  candidateEmail  String?
  role            String
  round           String          @default("Technical Round")
  interviewer     String          @default("HR Hiring Manager")
  interviewerRole String?
  date            DateTime        @default(now())
  time            String          @default("10:00 AM")
  duration        String          @default("45 mins")
  meetLink        String?
  status          String          @default("SCHEDULED") // "SCHEDULED", "COMPLETED", "CANCELLED", "RESCHEDULED"
  feedback        String?
  score           Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobOpening      JobOpening?     @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([jobOpeningId])
  @@index([date])
  @@index([status])
  @@map("job_interviews")
}

model RecruitmentTaxonomy {
  id          String   @id @default(uuid())
  type        String   // "CATEGORY" | "TYPE" | "LOCATION" | "SKILL" | "EXPERIENCE"
  name        String
  code        String?
  description String?
  extra       String?  // JSON stringified metadata for custom tab properties
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([active])
  @@map("recruitment_taxonomies")
}

// ====================================================
// DOCUMENT VAULT (ISSUED DOCS + COMPANY POLICIES)
// ====================================================

enum VaultDocumentKind {
  ISSUED
  POLICY
}

model VaultDocument {
  id              String            @id @default(uuid())
  kind            VaultDocumentKind // ISSUED | POLICY
  referenceNumber String            @unique
  title           String
  type            String            // OFFER_LETTER, CONTRACT, NDA, GOVERNANCE, etc.
  typeLabel       String?
  description     String?
  version         String?           // For policies: "v1.0 (2026)"
  department      String?
  issuer          String?
  status          String            @default("VERIFIED") // VERIFIED | PENDING | DRAFT
  size            String?
  fileUrl         String?           // Cloudinary secure_url
  cloudinaryId    String?           // Cloudinary public_id (for deletion)
  mimeType        String?

  // ISSUED doc fields
  employeeId      String?           // References users.id (issued-to employee)
  employeeName    String?
  employeeCode    String?
  employeeEmail   String?
  designation     String?
  expiryDate      DateTime?
  notifyEmployee  Boolean           @default(true)
  uploadedBy      String?           // Role: "HR" | "EMPLOYEE"

  uploadedById    String?           // The user who created this record (nullable for SET NULL on user deletion)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  uploader        User?             @relation("VaultUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  issuedTo        User?             @relation("VaultIssuedTo", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([employeeId])
  @@index([uploadedById])
  @@index([createdAt])
  @@map("vault_documents")
}
