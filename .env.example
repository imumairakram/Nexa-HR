# Environment Variables Template for NexaHR Backend
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String Template
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nexahr?schema=public"

# JWT Authentication Secrets
# JWT_SECRET must be at least 32 characters (256-bit entropy).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -base64 32
JWT_SECRET="generate_a_secure_random_key_of_at_least_32_characters"
JWT_EXPIRES_IN="1h"

# Frontend Application URL
FRONTEND_URL="http://localhost:5173"

# Backend Application Public URL (Render Deployment)
# Used by the background self-ping service to ping /api/health every 14 minutes and prevent free-tier spindown
BACKEND_URL="https://your-app.onrender.com"

# Biometric Hardware Integration Secret Key
HARDWARE_SECRET_KEY="your_hardware_secret_key"

# Cloudinary Cloud Storage Configuration (Ephemeral hosting e.g., Render)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ====================================================
# CORPORATE SMTP EMAIL CONFIGURATION (Nodemailer)
# ====================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
EMAIL_FROM="NexaHR Security <no-reply@nexahr.com>"

# ====================================================
# WHATSAPP OTP DISPATCH API (Twilio / Meta Cloud API)
# ====================================================
# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_KEY="your_meta_whatsapp_cloud_api_token"
META_WHATSAPP_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_PHONE_NUMBER="+1234567890"

# ====================================================
# AI-POWERED ATS SCREENING & GMAIL INTEGRATION
# ====================================================
# Google Cloud OAuth 2.0 Credentials (Gmail API)
# Required Scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/oauth2callback"
GMAIL_REFRESH_TOKEN="your_gmail_oauth_refresh_token"
GMAIL_HR_ADDRESS="hr@yourcompany.com"
GMAIL_POLL_CRON="*/5 * * * *"
GMAIL_SEARCH_QUERY="is:unread has:attachment -label:NexaHR-Processed"

# AI Provider Configuration
# AI_PROVIDER: gemini | openai | anthropic
AI_PROVIDER="gemini"
AI_API_KEY="your_gemini_or_openai_or_anthropic_api_key"
AI_MODEL="gemini-1.5-flash"
ATS_PASS_THRESHOLD=70

# ====================================================
# GUEST DEMO MODE CONFIGURATION (Frontend-Only)
# ====================================================
# Set to 'true' in client build to enable 1-Click Guest HR and Guest Employee buttons
VITE_ENABLE_GUEST_DEMO="true"
# Optional ISO date deadline for demo mode (e.g. "2026-12-31T23:59:59Z")
# VITE_GUEST_DEMO_UNTIL="2026-12-31T23:59:59Z"
