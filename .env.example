# Environment Variables Template for NexaHR Backend
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String Template (Development / Local Scratch)
# Live/production Supabase credentials must reside ONLY in Render/Vercel secret dashboards.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nexahr_dev?schema=public"

# Direct PostgreSQL Connection URL (Bypasses PgBouncer pooler for migrations & transactions)
# Required on Render / Supabase for prisma migrate deploy and scripts
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/nexahr_dev?schema=public"

# Test / Scratch Database URL (Strictly required for running DB integration & smoke tests)
# Must point to an isolated test/scratch database (e.g. nexahr_scratch).
# Scripts and tests abort immediately if this targets a live production host without LIVE_OK=true.
TEST_DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nexahr_scratch?schema=public"

# JWT Authentication Secrets
# JWT_SECRET must be at least 32 characters (256-bit entropy).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -base64 32
JWT_SECRET="generate_a_secure_random_key_of_at_least_32_characters"
JWT_EXPIRES_IN="1h"

# Authorized CORS Origins (Comma-separated in production)
# Example: "https://your-app.vercel.app,https://nexa-hr-xi.vercel.app"
CORS_ORIGINS="http://localhost:5173"

# Frontend Application URL (Fallback for CORS if CORS_ORIGINS is not set)
FRONTEND_URL="http://localhost:5173"

# Backend Application Public URL (Render Deployment)
# Used by the background self-ping service to ping /api/health every 14 minutes and prevent free-tier spindown
BACKEND_URL="https://your-app.onrender.com"

# Biometric Hardware Integration Secret Key
HARDWARE_SECRET_KEY="your_hardware_secret_key"

# Cloudinary Cloud Storage Configuration (Ephemeral hosting e.g., Render)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ====================================================
# CORPORATE SMTP EMAIL CONFIGURATION (Outbound Transactional)
# Recommendation: Use a dedicated transactional sending mailbox/service
# (e.g., notifications@company.com via AWS SES, Resend, SendGrid, or Gmail App Password)
# Keep this separate from GMAIL_HR_ADDRESS to prevent bounce loops.
# ====================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@company.com"
SMTP_PASS="your_app_specific_password"
EMAIL_FROM="NexaHR Notifications <no-reply@company.com>"

# ====================================================
# WHATSAPP OTP DISPATCH API (Twilio / Meta Cloud API)
# ====================================================
# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_KEY="your_meta_whatsapp_cloud_api_token"
META_WHATSAPP_TOKEN="your_meta_whatsapp_cloud_api_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_PHONE_NUMBER="+1234567890"

# ====================================================
# AI-POWERED ATS SCREENING & GMAIL INTEGRATION (Inbound Candidates)
# Dedicated inbound candidate intake inbox (e.g., careers@company.com).
# ====================================================
# Google Cloud OAuth 2.0 Credentials (Gmail API)
# Required Scopes: https://www.googleapis.com/auth/gmail.readonly, https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/oauth2callback"
GMAIL_REFRESH_TOKEN="your_gmail_oauth_refresh_token"
GMAIL_HR_ADDRESS="careers@company.com"
GMAIL_POLL_CRON="*/5 * * * *"
GMAIL_SEARCH_QUERY="is:unread has:attachment -label:NexaHR-Processed -label:NexaHR-Ignored -from:mailer-daemon -from:postmaster -from:me -subject:(\"Delivery Status Notification\") -subject:(\"Undeliverable\")"

# AI Provider Configuration
# AI_PROVIDER: gemini | openai | anthropic
AI_PROVIDER="gemini"
AI_API_KEY="your_gemini_or_openai_or_anthropic_api_key"
# Default for Gemini is gemini-3.8-flash (with automatic fallback to gemini-3.5-flash and gemini-3.1-flash-lite)
AI_MODEL="gemini-3.8-flash"
ATS_PASS_THRESHOLD=70

# ====================================================
# GUEST DEMO MODE CONFIGURATION (Frontend-Only)
# ====================================================
# Set to 'true' in client build to enable 1-Click Guest HR and Guest Employee buttons
VITE_ENABLE_GUEST_DEMO="true"
# Optional ISO date deadline for demo mode (e.g. "2026-12-31T23:59:59Z")
# VITE_GUEST_DEMO_UNTIL="2026-12-31T23:59:59Z"
