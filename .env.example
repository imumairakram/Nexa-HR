# Environment Variables Template for NexaHR Backend
PORT=5000

# PostgreSQL Connection String Template
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nexahr?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"
